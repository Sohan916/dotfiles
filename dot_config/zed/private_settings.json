// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "cli_default_open_behavior": "existing_window",
  "helix_mode": false,
  "icon_theme": "VSCode Icons for Zed (Dark)",
  "agent_servers": {
    "claude-acp": {
      "default_config_options": {
        "fast": true,
        "mode": "auto",
        "model": "opus",
        "effort": "default",
      },
      "type": "registry",
    },
  },
  "format_on_save": "on",
  "formatter": "prettier",

  "languages": {
    "SCSS": {
      "format_on_save": "on",
      "formatter": "prettier",
    },
    "JavaScript": {
      "code_actions_on_format": {
        "source.organizeImports": true,
        "source.fixAll.eslint": true,
      },
    },
    "JSX": {
      "code_actions_on_format": {
        "source.organizeImports": true,
        "source.fixAll.eslint": true,
      },
    },
    "TypeScript": {
      "code_actions_on_format": {
        "source.organizeImports": true,
        "source.fixAll.eslint": true,
      },
    },
    "TSX": {
      "code_actions_on_format": {
        "source.organizeImports": true,
        "source.fixAll.eslint": true,
      },
    },
  },

  "project_panel": {
    "dock": "left",
  },
  "outline_panel": {
    "dock": "left",
  },
  "collaboration_panel": {
    "dock": "left",
  },
  "git_panel": {
    "dock": "left",
  },
  "agent": {
    "play_sound_when_agent_done": "when_hidden",
    "sidebar_side": "right",
    "dock": "right",
    "default_profile": "ask",
    "terminal_init_command": "claude",
    "default_model": {
      "effort": "medium",
      "provider": "anthropic",
      "model": "claude-sonnet-5-5",
      "enable_thinking": true,
    },
    "favorite_models": [],
    "model_parameters": [],
    "commit_message_model": {
      "provider": "anthropic",
      "model": "claude-4-5-haiku",
    },
    "commit_message_instructions": "The commit should start with the ticket number available in the branch name eg:MOB-282 if available and should be followed with the semantic commit message in square brackets after which the commit message should be written",
  },
  "vim_mode": true,
  "terminal": {
    "env": {},
  },
  "autosave": "on_focus_change",
  "linked_edits": true,
  "base_keymap": "Zed",
  "ui_font_size": 16,
  "buffer_font_size": 15,
  "theme": {
    "mode": "system",
    "light": "One Dark",
    "dark": "Ayu Dark",
  },
  "lsp": {
    "eslint": {
      "settings": {
        "codeActionOnSave": {
          "rules": ["import/order"],
        },
      },
    },
  },
}
